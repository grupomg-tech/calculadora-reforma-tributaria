# Copy to `.env.local` and adjust. All variables are optional; the defaults
# match a deployment under a sub-path of the backend.

# Endpoint that returns the report.
VITE_API_URL=/dashboards/api/graficos/dados-relatorio/

# Absolute URL when the report is served by the example backend
# (`npx --yes tsx examples/backend-node/server.ts`). A relative path is
# fetched from the Vite origin, so it would not reach that process.
# VITE_API_URL=http://127.0.0.1:8787/dashboards/api/graficos/dados-relatorio/

# Public path of the built assets (used by Vite at build time).
VITE_BASE=/static/dashboard-cliente/

# `basename` of the router; must match where the app is hosted.
VITE_ROUTER_BASENAME=/dashboards/dashboard-cliente

# Set to "true" to always use the built-in fictional dataset (no backend needed).
# At runtime, `?demo=1` in the URL does the same for a single visit.
VITE_DEMO=false
